{
  "manifest_version": 3,
  "name": "多平台自动找号助手",
  "version": "1.1.0",
  "version_name": "1.1.0",
  "description": "从多平台内容流中自动发现符合规则的达人和视频，并将观察结果上传到研究台。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "power",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开多平台自动找号助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:4173/*"
      ],
      "js": [
        "workbench-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "page/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "content/douyin-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dy.feigua.cn/app/*"
      ],
      "js": [
        "content/feigua-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/floating-launcher.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
