{
  "name": "multiplatform-creator-discovery-extension",
  "version": "1.0.17",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite build --watch",
    "preview": "pnpm build && node scripts/preview-extension.mjs",
    "build": "vite build",
    "version:patch": "node scripts/bump-version.mjs patch",
    "test": "node --test lib/*.test.js --experimental-strip-types src/core/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/verify-dist.mjs",
    "package": "pnpm check && node scripts/package-extension.mjs",
    "bridge": "node bridge/server.mjs",
    "bridge:install": "node scripts/bridge-service.mjs install",
    "bridge:status": "node scripts/bridge-service.mjs status",
    "bridge:uninstall": "node scripts/bridge-service.mjs uninstall",
    "team:setup": "node scripts/team-setup.mjs",
    "team:package": "pnpm package"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "0.2.8",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "archiver": "8.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
